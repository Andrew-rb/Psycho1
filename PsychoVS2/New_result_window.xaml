<Window x:Class="PsychoVS2.New_result_window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PsychoVS2"
        mc:Ignorable="d"
        Title="New_result_window" Height="450" Width="800">
    <Grid>
        <Label Content="Результаты" Margin="357,20,365,384" RenderTransformOrigin="0.5,0.5">
        </Label>
        <ScrollViewer Background="LightGray" VerticalScrollBarVisibility="Auto" Margin="104,71,104,71">
            <StackPanel x:Name="Labels_Panel" Orientation="Vertical">
            </StackPanel>
        </ScrollViewer>
        <Button Content="Выход" Padding="40,15"
        x:Name="ExitButton" Click="ExitButton_Click" Margin="248,368,256,14">
            <Button.Effect>
                <DropShadowEffect BlurRadius="8" Opacity="0.4" ShadowDepth="3"/>
            </Button.Effect>
        </Button>
    </Grid>
</Window>
