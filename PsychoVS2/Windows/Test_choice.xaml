<Window x:Class="PsychoVS2.Windows.Test_choice"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:materialDesign="http://schemas.materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PsychoVS2.Windows"
        mc:Ignorable="d"
        Title="Test_Start" Height="1174" Width="1653" Background="#FF3A454B" WindowStyle="None" Loaded="Window_Loaded">
    <Grid>
        <!-- Заголовок сверху по центру -->
        <Label Content="Тесты"
                   HorizontalAlignment="Center" VerticalAlignment="Top"
                   FontSize="32" FontWeight="Bold" Foreground="#FFFFCA28"
                   FontFamily="Montserrat"
                   Padding="0" Background="Transparent" BorderThickness="0"/>

        <Canvas>

            <!-- КНОПКА 1  -->

            <ScrollViewer Height="1023" Width="1498" Canvas.Top="42" Canvas.Left="75" VerticalScrollBarVisibility="Auto">
                <WrapPanel Orientation="Horizontal"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               ItemHeight="448" ItemWidth="349"
               x:Name="Panel_for_buttons"/>
            </ScrollViewer>

        </Canvas>

        <!-- Кнопка закрытия с плавным скруглением -->
        <Button x:Name="CloseButton" Content="×" Width="35" Height="35" 
                HorizontalAlignment="Right" VerticalAlignment="Top" 
                Margin="0,15,15,0" Click="CloseButton_Click"
                Background="#FF6B6B6B" Foreground="White" 
                FontSize="18" FontWeight="Bold" FontFamily="Arial">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="17.5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="0"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFE53935"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFC62828"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>