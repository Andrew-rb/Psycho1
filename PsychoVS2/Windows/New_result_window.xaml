<Window x:Class="WpfApp1.New_result_window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Результаты тестирования" 
        Height="920" 
        Width="1500"
        Background="#FF3A454B"
        FontFamily="Segoe UI" WindowStyle="None">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF3A454B" Offset="0"/>
                <GradientStop Color="#FF3A454B" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Width="300" Height="300" Opacity="0.05" Fill="#FF1976D2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-100"/>
        <Ellipse Width="200" Height="200" Opacity="0.05" Fill="#FF1976D2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-100,-100"/>

        <!-- Верхняя панель -->
        <Border Background="#FFF3B90D" Height="80" VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.3" ShadowDepth="3"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Viewbox Grid.Column="0" Width="40" Height="40" Margin="20,0" OpacityMask="#FF39D124">
                    <Canvas Width="24" Height="24">
                        <Path Fill="White" Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,12L11,16.5Z"/>
                    </Canvas>
                </Viewbox>

                <!-- Заголовок -->
                <TextBlock Grid.Column="1" 
                           Text="РЕЗУЛЬТАТЫ ТЕСТИРОВАНИЯ" 
                           Foreground="White" 
                           FontSize="24" 
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <Border Grid.Column="2" Width="40" Height="40" Margin="20,0" CornerRadius="20"
                        BorderBrush="White" BorderThickness="2" Opacity="0.5"/>
            </Grid>
        </Border>

        <!-- Основная область контента -->
        <Grid Margin="40,100,40,120">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Подзаголовок -->
            <TextBlock Grid.Row="0" 
                       Text="Ваши результаты" 
                       Foreground="White" 
                       FontSize="18" 
                       FontWeight="Medium"
                       Margin="0,0,0,20"
                       HorizontalAlignment="Center"/>

            <!-- Контейнер для результатов -->
            <Border Grid.Row="1" 
                    Background="White" 
                    CornerRadius="15"
                    Padding="30"
                    BorderThickness="1"
                    BorderBrush="#E0E0E0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.1" ShadowDepth="5"/>
                </Border.Effect>

                <!-- для результатов -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="5">
                    <StackPanel x:Name="Labels_Panel" Orientation="Vertical" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Label для результатов -->
        <Label x:Name="ResultTemplate" 
               Visibility="Collapsed"
               Content="Template"
               FontSize="16"
               Foreground="#333333"
               Background="White"
               Padding="20"
               Margin="0,0,0,15"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch">
            <Label.Template>
                <ControlTemplate TargetType="Label">
                    <Border CornerRadius="10" 
                            Background="{TemplateBinding Background}"
                            BorderThickness="1"
                            BorderBrush="#E0E0E0"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" Opacity="0.05" ShadowDepth="2"/>
                        </Border.Effect>
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Label.Template>
        </Label>

        <!-- Нижняя панель с кнопкой -->
        <Border Background="White" Height="100" VerticalAlignment="Bottom">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="-3"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Rectangle Grid.Column="0" Height="1" Fill="#E0E0E0" VerticalAlignment="Center" Margin="40,0"/>

                <!-- Кнопка выхода -->
                <Button Grid.Column="1" 
                        Content="ВЫХОД" 
                        x:Name="ExitButton" 
                        Click="ExitButton_Click"
                        Padding="60,10"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Background="#FF6A5ACD"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand" Margin="0,0,0,32">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.3" ShadowDepth="3"/>
                    </Button.Effect>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FF1976D2"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF1565C0"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="15" Opacity="0.4" ShadowDepth="4"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#FF0D47A1"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="5" Opacity="0.2" ShadowDepth="1"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Rectangle Grid.Column="2" Height="1" Fill="#E0E0E0" VerticalAlignment="Center" Margin="0,0,40,0"/>
            </Grid>
        </Border>

        <Border Background="#F5F5F5" Height="30" VerticalAlignment="Bottom">
            <Grid/>
        </Border>
    </Grid>
</Window>